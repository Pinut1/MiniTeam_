# Auto detect text files and perform LF normalization
* text=auto

# Unity 텍스트 에셋 — 항상 LF 유지 (CRLF 변환 시 Unity가 파싱 실패)
*.unity text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.cs text eol=lf

# Git LFS — 대용량 바이너리 에셋
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.controller filter=lfs diff=lfs merge=lfs -text

# Unity meta 파일 — GUID 보호 (자동 머지 금지)
*.meta merge=ours
