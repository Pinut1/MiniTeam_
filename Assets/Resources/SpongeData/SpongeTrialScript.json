  "testimonyLines": 
  [
    {
      "txt": "단체 손님이 들어와서\n굉장히 바쁜날이었습니다.",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    },
    {
      "txt": "직원 두명과 저는\n정신이 없었습니다.",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    },
    {
      "txt": "그때 전 잠시 일이 있어\n밖에 나가있었고",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    },
    {
      "txt": "어쩔 수 없이 직원 두명이\n일을 해야했습니다.",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    },
    {
      "txt": "바쁜틈을 타 뚱이가 몰래\n집게리아 안으로 들어갔습니다.",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    },
    {
      "txt": "아니글쎄 뚱이가 손님에게 나갈\n게살버거를 먹고 있는겁니다!",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    },
    {
      "txt": "그래서 바로\n신고를 했지요.",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    }
  ],
