      "deskSpr": "",
      "characterType": 0,
      "characterPos": 0,
      "choices": [],
      "nextLineId": "opening_19",
      "alignment": "Center"
    },
    {
      "lineId": "opening_19",
      "speaker": "스폰지밥",
      "txt": "이번 사건은 지극히 간단하다.",
