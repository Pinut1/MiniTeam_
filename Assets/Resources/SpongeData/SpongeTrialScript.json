      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
    },
    {
      "txt": "게살버거를 먹고 있는 것\n아니겠습니까?!",
      "ispressable": false,
      "firstPressDialogueId": "",
      "isRequiredPress": false,
      "validEvidenceIds": [],
      "evidenceSuccessDialogueId": "",
      "isRequiredEvidence": false
