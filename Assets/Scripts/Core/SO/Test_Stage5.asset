  sentences:
  - text: "\uB108\uAC00 \uC8FC\uB315\uCE58\uC5D0\uAC8C \uD544\uC694\uD55C\uAC78 \uAD6C\uD574\uC918\uC11C
      \uD589\uBCF5\uD558\uB2E4\uCE58!!"
    expressionSprite: {fileID: 21300000, guid: 329fb61d219204943a8c3e00860618d8, type: 3}
  - text: "\uD639\uC2DC \uB108\uB3C4 \uC774\uACF3\uC5D0 \uC788\uC73C\uBA74\uC11C
      \uD589\uBCF5\uD588\uB0D0\uCE58?"
    expressionSprite: {fileID: 21300000, guid: 329fb61d219204943a8c3e00860618d8, type: 3}
  - text: "\uC774\uC81C \uC6D0\uB798 \uC138\uC0C1\uC73C\uB85C \uB3CC\uC544\uAC08
      \uC2DC\uAC04\uC774\uB2E4\uCE58..."
    expressionSprite: {fileID: 21300000, guid: 329fb61d219204943a8c3e00860618d8, type: 3}
  - text: "\uC990\uAC70\uC6B4 \uC2DC\uAC04\uC740 \uAE08\uBC29 \uAC00\uB294\uAD6C\uB098\uCE58..."
