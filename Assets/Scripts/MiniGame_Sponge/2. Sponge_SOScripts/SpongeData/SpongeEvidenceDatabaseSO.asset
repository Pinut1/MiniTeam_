  evidences:
  - id: recorder
    evidenceName: "\uB6B1\uC774\uC758 \uC808\uCE5C\uC758 \uC99D\uC5B8 \uB179\uC74C"
    description: "\u201C\uC81C\uAC00 \uC5B4\uB835\uAC8C \uAD6C\uD55C \uBE75\uC744
      \uB6B1\uC774\uC5D0\uAC8C \uC8FC\uACE0 \uC2F6\uC5B4\uC11C \uAC00\uAC8C\uB85C
      \uC640 \uBE75\uC744 \uBA39\uC5B4\uBCF4\uB77C\uACE0 \uD588\uC5B4\uC694!\u201D\uB77C\uACE0
      \uB179\uC74C \uB418\uC5B4\uC788\uB2E4."
    icon: {fileID: 21300000, guid: 1a0858b8be7807246986faac5f2285a7, type: 3}
  - id: burger
    evidenceName: "\uBA39\uB2E4 \uB0A8\uC740 \uAC8C\uC0B4\uBC84\uAC70"
    description: "\uBA39\uC740 \uD754\uC801\uC774 \uB0A8\uC544\uC788\uB2E4. \uAC8C\uC0B4\uBC84\uAC70\uC5D0
      \uD2B9\uC774\uD55C \uC790\uAD6D\uC774 \uB0A8\uC544\uC788\uB2E4. \uD2B9\uC774\uD55C
      \uC790\uAD6D\uC744 \uBCF4\uBA74 \uC9D1\uAC8C\uC0AC\uC7A5 \uC9D1\uAC8C \uC190\uC758
      \uC790\uAD6D\uACFC \uB611\uAC19\uB2E4."
    icon: {fileID: 21300000, guid: 73fd89194cf24c24e9446f195fb31a3c, type: 3}
  - id: bread
    evidenceName: "\uACE0\uB824\uC740\uB2E8/\uBBFC\uD2B8\uCD08\uCF54/\uBD88\uB2ED\uC18C\uC2A4\uB97C
      \uC11E\uC5B4\uC11C \uB9CC\uB4E0 \uD55C\uC815\uD310 \uBE75\uC758 \uB72F\uC5B4\uC9C4
      \uBD09\uC9C0"
    description: "\uC5B4\uB514\uC11C\uB3C4 \uAD6C\uD558\uAE30 \uD798\uB4E0 \uD55C\uC815\uD310
      \uC2A4\uD398\uC15C \uBE75\uC758 \uB72F\uC5B4\uC9C4 \uBD09\uC9C0. \uC2A4\uD398\uC15C
      \uBE75\uC778 \uB9CC\uD07C \uD2B9\uC774\uD55C \uBAA8\uC591\uC744 \uAC00\uC84C\uB2E4.
      \uD584\uBC84\uAC70 \uBAA8\uC591\uC774 \uC808\uB300 \uC544\uB2C8\uB2E4."
    icon: {fileID: 21300000, guid: 73b21b1065f720941a2f276ace9d30f6, type: 3}
  - id: poster
    evidenceName: "\uD3B8\uC758\uC810 \uD3EC\uC2A4\uD130"
    description: "\uD55C\uC815\uD310 \uBE75\uC744 \uD310\uB9E4\uD558\uB294 \uC774\uBCA4\uD2B8
      \uD3EC\uC2A4\uD130. \uC57D\uAC04 \uCC22\uC5B4\uC838\uC788\uB2E4. \"\uCD08\uCD08\uCD08\uD2B9\uAE09
      \uD55C\uC815\uD310 \uBE75\uC774 \uB098\uC654\uB2E4!! ??\uC6D4 ??\uC77C~3\uC6D4
      1\uC77C\uAE4C\uC9C0 \uD310\uB9E4 \uC9C4\uD589!\"...\uC774\uB77C\uACE0 \uC801\uD600\uC788\uB2E4."
    icon: {fileID: 0}
  - id: receipt
    evidenceName: "\uAC00\uAC8C \uB9E4\uCD9C \uC601\uC218\uC99D"
    description: "4\uC6D4 26\uC77C \uC9D1\uAC8C\uB9AC\uC544 \uB9C8\uAC10 \uD6C4 \uBF51\uC740
      \uB9E4\uCD9C \uC601\uC218\uC99D\uC774\uB2E4."
    icon: {fileID: 0}
  - id: bankstatement
    evidenceName: "\uBA85\uC138\uD45C"
    description: "'\uBA85\uC138\uD45C' \uC548\uC5D0 4\uC6D4 26\uC77C\uC774\uB77C\uACE0
      \uC801\uD600\uC788\uB2E4. \uBA85\uC138\uD45C\uB97C \uC790\uC138\uD788 \uBCF4\uBA74
      \uC624\uC804 10\uC2DC 31\uBD84\uC774\uB77C \uC801\uD600\uC788\uB2E4."
    icon: {fileID: 0}
